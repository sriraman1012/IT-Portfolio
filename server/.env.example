# ==================================================================
# Copy this file to ".env" and fill it in.  NEVER commit .env.
# The 16-digit app password belongs here and nowhere else — not in
# index.html, not in any frontend file.
# ==================================================================

# The Gmail account that sends the mail (full address)
GMAIL_USER=sriramanrangarajan10@gmail.com

# 16-digit Google App Password.  Spaces are fine — they get stripped.
# Get one at: https://myaccount.google.com/apppasswords
# (needs 2-Step Verification switched on first)
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Where enquiries are delivered. Defaults to GMAIL_USER if left out.
MAIL_TO=sriramanrangarajan10@gmail.com

# Port the API listens on
PORT=8080

# Sites allowed to call the API, comma separated.
# Leave EMPTY to allow any origin (fine for local testing).
# Once deployed, lock it down, e.g.:
#   ALLOWED_ORIGINS=https://your-site.com,http://localhost:5500
ALLOWED_ORIGINS=
